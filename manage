#!/usr/bin/env bash
set -euo pipefail
umask 077

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
state="$HOME/.local/share/momo-index"
config="$HOME/.config/momo-index"
engine_commit=d9e41aac89fd00b3d71497fddb287b7f24613712

fail() { printf '%s\n' "$*" >&2; exit 1; }

mkdir -p "$state" "$config"
exec 9>"$state/deployment.lock"
flock -n 9 || fail "Another deployment is running"

prepare() {
    local data="${1:?Pass a writable data directory on the model disk}"
    local gpu="${2:?Pass a GPU index or UUID from nvidia-smi}"
    [[ "$data" = /* && "$data" != *[[:space:]]* && "$data" != *"'"* && -d "$data" && -w "$data" ]] ||
        fail "Model data directory must already exist, be writable and have a simple absolute path"
    [[ "$gpu" =~ ^([0-9]+|GPU-[[:xdigit:]-]+)$ ]] || fail "Invalid GPU index or UUID"
    [[ ! -e "$config/service.env" ]] || fail "Host already configured. Use prepare-models to resume downloads."
    command -v uv >/dev/null || fail "Install uv before running prepare"

    mkdir -p "$state/slots" "$data/cache" "$data/tmp" "$data/checkpoints"
    touch "$state/19881.lock" "$state/19882.lock"
    if [[ ! -s "$config/api-key" ]]; then
        python3 -c 'import secrets; print(secrets.token_urlsafe(32))' > "$config/api-key"
    fi
    cat > "$config/service.env.new" <<ENV
MOMO_INDEX_STATE='$state'
MOMO_INDEX_DATA='$data'
MOMO_INDEX_MODELS='$data/checkpoints'
MOMO_INDEX_KEY_FILE='$config/api-key'
CUDA_VISIBLE_DEVICES='$gpu'
HF_HOME='$data/cache/huggingface'
HF_HUB_CACHE='$data/checkpoints/hf_cache'
MODELSCOPE_CACHE='$data/cache/modelscope'
XDG_CACHE_HOME='$data/cache'
UV_CACHE_DIR='$data/cache/uv'
UV_PYTHON_INSTALL_DIR='$data/python'
UV_PROJECT_ENVIRONMENT='$data/venv'
TMPDIR='$data/tmp'
ENV
    mv "$config/service.env.new" "$config/service.env"
    load_configuration
    prepare_models
}

load_configuration() {
    [[ -r "$config/service.env" ]] || fail "Run prepare first"
    set -a
    source "$config/service.env"
    set +a
    unset HF_HUB_OFFLINE TRANSFORMERS_OFFLINE
}

prepare_models() {
    command -v uv >/dev/null || fail "Install uv before running prepare-models"
    if systemctl --user is-active --quiet momo-index-worker@19881.service ||
        systemctl --user is-active --quiet momo-index-worker@19882.service; then
        fail "Stop both workers in a maintenance window before changing the shared model environment"
    fi
    if [[ ! -d "$state/upstream/.git" ]]; then
        git init -q "$state/upstream"
        git -C "$state/upstream" remote add origin https://github.com/index-tts/index-tts.git
    fi
    if ! git -C "$state/upstream" cat-file -e "$engine_commit^{commit}" 2>/dev/null; then
        git -C "$state/upstream" fetch --depth 1 origin "$engine_commit"
    fi
    GIT_LFS_SKIP_SMUDGE=1 git -C "$state/upstream" checkout -q --detach "$engine_commit"
    mkdir -p "$MOMO_INDEX_DATA/cache/tagger"
    local tagger="$state/upstream/indextts/utils/tagger_cache"
    if [[ ! -e "$tagger" && ! -L "$tagger" ]]; then
        ln -s "$MOMO_INDEX_DATA/cache/tagger" "$tagger"
    fi
    uv sync --project "$state/upstream" --python 3.11 --frozen --no-install-project
    uv pip install --python "$MOMO_INDEX_DATA/venv/bin/python" -r "$source_dir/requirements.txt"
    PYTHONPATH="$source_dir" "$MOMO_INDEX_DATA/venv/bin/python" -m momo_tts.checkpoints
}

bootstrap() {
    [[ -d "$MOMO_INDEX_DATA/venv" ]] || fail "Run prepare-models first"
    if [[ ! -d "$state/gateway" ]]; then
        mkdir -p "$state/gateway.new"
        cp -R "$source_dir/momo_tts" "$state/gateway.new/"
        uv venv --allow-existing --python /usr/bin/python3 "$state/gateway-env"
        uv pip install --python "$state/gateway-env/bin/python" -r "$source_dir/requirements.txt"
        mv "$state/gateway.new" "$state/gateway"
    fi
    install -d "$HOME/.config/systemd/user"
    install -m 0700 "$source_dir/systemd/run" "$state/run.new"
    mv "$state/run.new" "$state/run"
    install -m 0644 "$source_dir"/systemd/*.service "$HOME/.config/systemd/user/"
    systemctl --user daemon-reload
    systemctl --user enable --now momo-index-gateway.service
}

probe() {
    PYTHONPATH="$source_dir" "$state/gateway-env/bin/python" -m momo_tts.probe "$@"
}

point_slot() {
    local slot="$1" target="$2"
    ln -sfn "$target" "$state/slots/$slot.new"
    mv -Tf "$state/slots/$slot.new" "$state/slots/$slot"
}

switch_worker() {
    local operation="$1" reference="${2:?Pass a licensed speech reference for the synthesis check}"
    [[ -r "$reference" ]] || fail "Cannot read reference audio"
    [[ -d "$state/gateway" ]] || fail "Run bootstrap first"
    local previous= candidate=19881 unit previous_target
    if [[ -f "$state/active" ]]; then
        previous=$(<"$state/active")
        [[ "$previous" = 19881 || "$previous" = 19882 ]] || fail "Invalid live slot"
        if [[ "$previous" = 19881 ]]; then candidate=19882; fi
    fi
    unit="momo-index-worker@$candidate.service"
    previous_target=$(readlink "$state/slots/$candidate" || true)
    # A previous drain can leave the spare worker alive. Retire it before replacing its files.
    if [[ "$operation" != rollback ]]; then
        flock -w 130 "$state/$candidate.lock" systemctl --user disable --now "$unit"
        local release
        if [[ "$operation" = restart && -n "$previous" ]]; then
            release=$(basename "$(readlink "$state/slots/$previous")")
        else
            release=$(git -C "$source_dir" rev-parse HEAD)
        fi
        [[ -d "$state/releases/$release" ]] || (
            mkdir -p "$state/releases"
            local pending
            pending=$(mktemp -d "$state/releases/.staging.XXXXXX")
            trap 'rm -rf -- "$pending"' EXIT
            git -C "$source_dir" archive "$release" | tar -xf - -C "$pending"
            mv "$pending" "$state/releases/$release"
        )
        point_slot "$candidate" "$state/releases/$release"
    else
        [[ -n "$previous" && -d "$state/slots/$candidate" ]] || fail "No rollback worker is available"
    fi
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    if ! systemctl --user start "$unit" ||
        ! probe "$candidate" --wait 600 --reference "$reference" ||
        ! systemctl --user enable "$unit"; then
        systemctl --user disable --now "$unit" || true
        if [[ -n "$previous_target" ]]; then
            point_slot "$candidate" "$previous_target"
        else
            rm -f "$state/slots/$candidate"
        fi
        fail "Candidate failed deployment; active endpoint was unchanged"
    fi
    printf '%s\n' "$candidate" > "$state/active.new"
    mv -T "$state/active.new" "$state/active"
    if [[ -n "$previous" ]]; then
        if ! flock -w 130 "$state/$previous.lock" systemctl --user disable --now "momo-index-worker@$previous.service"; then
            printf 'Traffic switched; slot %s still needs retirement.\n' "$previous" >&2
        fi
    fi
    printf 'Active inference port: %s\n' "$candidate"
}

case "${1:-}" in
    prepare) shift; prepare "$@" ;;
    prepare-models) load_configuration; prepare_models ;;
    bootstrap) load_configuration; bootstrap ;;
    deploy|restart|rollback) load_configuration; switch_worker "$@" ;;
    probe) shift; load_configuration; probe 19880 "$@" ;;
    *) fail "Usage: manage prepare DATA_DIR GPU | prepare-models | bootstrap | deploy|restart|rollback REFERENCE | probe [--reference WAV]" ;;
esac
