[Unit]
Description=momo IndexTTS inference worker on port %i
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
EnvironmentFile=%h/.config/momo-index/service.env
ExecStart=%h/.local/share/momo-index/run worker %i
Restart=on-failure
RestartSec=15s
TimeoutStopSec=150s
UMask=0077

[Install]
WantedBy=default.target
